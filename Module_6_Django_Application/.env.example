# TEDMind Django Application Environment Configuration (.env)
# Copy this file to .env for custom deployment configurations

# Security
DJANGO_SECRET_KEY=django-insecure-tedmind-demo-key-infosys-springboard-milestone-6-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Offline Hugging Face Hub (Prevents network timeouts when loading cached SentenceTransformers)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
