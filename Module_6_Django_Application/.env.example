# TEDMind Production & Development Environment Configuration
# Copy this file to .env and customize for your deployment environment

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# In production, generate a secure random 50+ character key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=tedmind-dev-insecure-key-change-in-production-2026-infosys-springboard

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames/IPs
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Set to True when HTTPS is enabled
DJANGO_SECURE_SSL_REDIRECT=False

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Leave empty to use local SQLite (db.sqlite3)
# For PostgreSQL: postgresql://user:password@localhost:5432/tedmind_db
DATABASE_URL=

# -----------------------------------------------------------------------------
# Hugging Face & Transformer Offline Mode
# -----------------------------------------------------------------------------
# Prevents remote connection timeouts when loading local model weights
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
